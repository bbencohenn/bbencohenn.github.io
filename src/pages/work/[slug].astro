---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { getProjects, digest, safeKey, type Project } from '../../lib/site';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.filter((p) => safeKey(p.id)).map((project) => ({ params: { slug: project.id }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;
---

<Base title={d.title} description={d.summary} type="article">
  <section class="page-head pad">
    <div class="wrap">
      <span class="crumbs"><a href="/">home</a> / <a href="/work/">work</a> / {project.id}</span>
      <h1 class="page-title">{d.title}</h1>
      <div class="meta-line">
        <span>{d.kind}</span>
        <span>{d.year}</span>
        <span>sha256 {digest(d.title, 12)}…</span>
        {d.link && <a href={d.link} rel="noopener">Live →</a>}
        {d.repo && <a href={d.repo} rel="noopener">Source →</a>}
      </div>
      <p class="intro">{d.summary}</p>
    </div>
  </section>

  <section class="article pad">
    <div class="wrap">
      <div class="article-body">
        {
          d.cover && (
            <figure class="cover">
              <Image src={d.cover} alt={d.cover_alt ?? ''} widths={[640, 1024, 1600]} sizes="(max-width: 1100px) 100vw, 1100px" />
            </figure>
          )
        }
        <div class="prose">
          <Content />
        </div>
        <nav class="pager" aria-label="Back">
          <a href="/work/"><span>← back</span><b>All work</b></a>
        </nav>
      </div>
    </div>
  </section>
</Base>
