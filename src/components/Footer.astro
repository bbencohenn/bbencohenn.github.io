---
import { execSync } from 'node:child_process';
import { getSettings } from '../lib/site';
const s = await getSettings();
const year = new Date().getFullYear();

// Short commit hash of this build. CI variables are tried first, then git
// itself; anything that isn't actually a hash (e.g. a branch name) is ignored.
const isSha = (v?: string) => !!v && /^[0-9a-f]{7,40}$/i.test(v.trim());
function buildCommit() {
  for (const v of [process.env.WORKERS_CI_COMMIT_SHA, process.env.GITHUB_SHA]) {
    if (isSha(v)) return v!.trim().slice(0, 7);
  }
  try {
    const head = execSync('git rev-parse --short=7 HEAD', { stdio: ['ignore', 'pipe', 'ignore'] }).toString().trim();
    return isSha(head) ? head : '';
  } catch {
    return '';
  }
}
const commit = buildCommit();
---

<footer class="site-footer pad">
  <div class="wrap">
    <p class="footer-big">EOF.</p>
    <div class="footer-row">
      <div class="stack">
        <a class="footer-mail" href={`mailto:${s.email}`}>{s.email}</a>
        {s.pgp && <span class="mono muted">PGP: {s.pgp}</span>}
      </div>
      <nav class="footer-links" aria-label="Elsewhere">
        <a href={s.github} rel="me noopener">GitHub</a>
        {s.linkedin && <a href={s.linkedin} rel="me noopener">LinkedIn</a>}
        <a href="/rss.xml">RSS</a>
        <a href="/.well-known/security.txt">security.txt</a>
      </nav>
    </div>
    <div class="footer-small">
      <span>No trackers, no cookies, no third-party requests. Works without JavaScript.</span>
      <span>© {year} {s.name}{commit && ` · build ${commit}`}</span>
    </div>
  </div>
</footer>
