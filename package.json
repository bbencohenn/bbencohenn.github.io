{
  "name": "bencohen-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal site of Ben Cohen: bencohen.com.au",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare-cms": "node scripts/copy-cms.mjs",
    "dev": "npm run prepare-cms && astro dev",
    "build": "npm run prepare-cms && astro build && node scripts/check-dist.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "deploy": "npm run build && npx wrangler deploy",
    "serve": "node scripts/serve.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.2",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/commissioner": "5.3.0",
    "@fontsource-variable/victor-mono": "5.3.0",
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@sveltia/cms": "0.221.1",
    "typescript": "^5.9.3"
  }
}
